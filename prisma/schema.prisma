generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Product {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  variant  String
  mrp      Float
  price    Float
  imageUrl String
  emiPlans EmiPlan[]
}

model EmiPlan {
  id             String  @id @default(cuid())
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  monthlyPayment Float
  tenureMonths   Int
  interestRate   Float
  cashbackAmount Float?
}
